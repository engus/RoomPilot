# Copy to .env in repository root. Never commit real credentials.
# Initial UI selection: openai, gemini, or openrouter. No automatic fallback.
AI_PROVIDER=openai
OPENAI_API_KEY=
# Set an available vision + structured-output model ID from your provider account.
OPENAI_MODEL=
# Google AI Studio key; choose a model available in your project's tier.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# OpenRouter key. The free router can select a different compatible model per request.
# For reproducible comparisons, set an explicit vision + structured-output model ID.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
# API is local-only in milestone 1; browser dev server proxies /api to this port.
# If changing PORT, also update the /api proxy in apps/web/vite.config.ts.
PORT=3001
# Optional: recognition request limit (default 45000 ms; env value clamped to 1–120 s).
RECOGNITION_TIMEOUT_MS=45000
