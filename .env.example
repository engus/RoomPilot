# Copy to .env in repository root. Never commit real credentials.
OPENAI_API_KEY=
# Set an available vision + structured-output model ID from your provider account.
OPENAI_MODEL=
# API is local-only in milestone 1; browser dev server proxies /api to this port.
# If changing PORT, also update the /api proxy in apps/web/vite.config.ts.
PORT=3001
# Optional: recognition request limit (default 45000 ms; env value clamped to 1–120 s).
RECOGNITION_TIMEOUT_MS=45000
